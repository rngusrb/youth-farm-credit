# LLM 경로를 켤 때만 필요. 없으면 규칙기반 추출 + 템플릿 해설로 동작한다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# 프론트 도메인. 미설정 시 * (개발용)
CORS_ORIGINS=https://your-app.vercel.app

LOG_LEVEL=INFO

# 공공데이터포털 인증키 — σ 실측 수집(stats/kamis.py)에만 쓴다.
# https://www.data.go.kr/data/15156057/openapi.do 에서 활용신청(자동승인) 후
# 마이페이지 > 일반 인증키(Decoding) 값을 넣는다. 서비스 실행에는 불필요.
DATA_GO_KR_SERVICE_KEY=
